rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Each signed-in user can only ever read/write their own data, under their
// own uid — nobody can read or write anyone else's messages/lists/campaigns/
// log/settings, including other authenticated users of this same project.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sync/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is denied by default (no catch-all rule below this).
  }
}
